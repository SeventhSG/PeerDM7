<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- White theme: the sky-blue Aero look of the late messenger era -->

    <LinearGradientBrush x:Key="Bg.Window" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#BFD8F3" Offset="0"/>
        <GradientStop Color="#DCEAF8" Offset="0.16"/>
        <GradientStop Color="#EEF4FB" Offset="0.45"/>
        <GradientStop Color="#F6F9FD" Offset="1"/>
    </LinearGradientBrush>
    <!-- Soft light bloom in the top left of every window -->
    <RadialGradientBrush x:Key="Bg.Glow" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.35">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Bg.Surface" Color="#FDFEFF"/>
    <SolidColorBrush x:Key="Bg.Subtle" Color="#E9F2FC"/>
    <SolidColorBrush x:Key="Bg.Pressed" Color="#D6E6F7"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#D3E5FA"/>
    <SolidColorBrush x:Key="Bg.Input" Color="#FDFEFF"/>
    <SolidColorBrush x:Key="Bg.Flyout" Color="#FAFCFE"/>

    <SolidColorBrush x:Key="Border.Default" Color="#A9C2DD"/>
    <SolidColorBrush x:Key="Border.Soft" Color="#D2E0EF"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#7EA6D2"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#1A2738"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#3D536D"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#5E7189"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#9DABBB"/>
    <SolidColorBrush x:Key="Text.Heading" Color="#1D4F8F"/>

    <SolidColorBrush x:Key="Accent" Color="#2F6FDB"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#2A63C5"/>
    <SolidColorBrush x:Key="Accent.Pressed" Color="#2457AE"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#DCEAFB"/>
    <SolidColorBrush x:Key="Accent.Text" Color="#1F5FC4"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FBFCFE"/>

    <!-- Glossy buttons -->
    <LinearGradientBrush x:Key="Button.Face" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDFEFF" Offset="0"/>
        <GradientStop Color="#F1F6FC" Offset="0.48"/>
        <GradientStop Color="#E1EBF7" Offset="0.52"/>
        <GradientStop Color="#E9F1FA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Border" Color="#9DB8D6"/>
    <LinearGradientBrush x:Key="Button.HoverFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4FAFF" Offset="0"/>
        <GradientStop Color="#E3F0FD" Offset="0.48"/>
        <GradientStop Color="#C9E1FA" Offset="0.52"/>
        <GradientStop Color="#DCEBFB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.HoverBorder" Color="#5E95D3"/>
    <LinearGradientBrush x:Key="Button.PressedFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C4DCF5" Offset="0"/>
        <GradientStop Color="#D7E8FA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Face" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#78B2F0" Offset="0"/>
        <GradientStop Color="#4A8BE6" Offset="0.48"/>
        <GradientStop Color="#2F6FDB" Offset="0.52"/>
        <GradientStop Color="#3C80E4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Accent.HoverFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8CC0F5" Offset="0"/>
        <GradientStop Color="#5A98EC" Offset="0.48"/>
        <GradientStop Color="#3A7BE6" Offset="0.52"/>
        <GradientStop Color="#4A8BEA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Accent.Border" Color="#2457AE"/>

    <!-- Section bands ("I want to...", headers) -->
    <LinearGradientBrush x:Key="Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F3F8FE" Offset="0"/>
        <GradientStop Color="#DDEAF8" Offset="0.5"/>
        <GradientStop Color="#CFE1F5" Offset="0.5"/>
        <GradientStop Color="#DCE9F8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Header.Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Accent.Rule" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002F6FDB" Offset="0"/>
        <GradientStop Color="#2F6FDB" Offset="0.2"/>
        <GradientStop Color="#7DB2F2" Offset="0.6"/>
        <GradientStop Color="#002F6FDB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Row.Selected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF3FE" Offset="0"/>
        <GradientStop Color="#C9DFF8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Row.SelectedBorder" Color="#84B0E3"/>
    <SolidColorBrush x:Key="Row.Hover" Color="#E8F2FD"/>
    <SolidColorBrush x:Key="Row.HoverBorder" Color="#BCD5F0"/>

    <SolidColorBrush x:Key="Gloss.Edge" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Danger.Text" Color="#B3261E"/>
    <SolidColorBrush x:Key="Progress.Track" Color="#DCE7F3"/>
    <Color x:Key="Shadow.Color">#1A3A66</Color>
    <BitmapImage x:Key="Logo" UriSource="pack://application:,,,/Assets/PeerDM7.png"/>
</ResourceDictionary>

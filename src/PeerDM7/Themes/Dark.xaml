<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme: the same Aero shapes at night -->

    <LinearGradientBrush x:Key="Bg.Window" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F3047" Offset="0"/>
        <GradientStop Color="#18222F" Offset="0.2"/>
        <GradientStop Color="#141A23" Offset="0.6"/>
        <GradientStop Color="#12161D" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Bg.Glow" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.35">
        <GradientStop Color="#265A8CD8" Offset="0"/>
        <GradientStop Color="#005A8CD8" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Bg.Surface" Color="#1A2029"/>
    <SolidColorBrush x:Key="Bg.Subtle" Color="#232C38"/>
    <SolidColorBrush x:Key="Bg.Pressed" Color="#2B3644"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#22344D"/>
    <SolidColorBrush x:Key="Bg.Input" Color="#161B22"/>
    <SolidColorBrush x:Key="Bg.Flyout" Color="#1E252F"/>

    <SolidColorBrush x:Key="Border.Default" Color="#34445A"/>
    <SolidColorBrush x:Key="Border.Soft" Color="#283445"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#4E6C94"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#AAB7C7"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8A97A9"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#58626F"/>
    <SolidColorBrush x:Key="Text.Heading" Color="#8DB8F2"/>

    <SolidColorBrush x:Key="Accent" Color="#2F6FDB"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#3A7BE6"/>
    <SolidColorBrush x:Key="Accent.Pressed" Color="#2A63C5"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#1D2C45"/>
    <SolidColorBrush x:Key="Accent.Text" Color="#7EAAF4"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FBFCFE"/>

    <LinearGradientBrush x:Key="Button.Face" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E3A4A" Offset="0"/>
        <GradientStop Color="#273241" Offset="0.48"/>
        <GradientStop Color="#1F2834" Offset="0.52"/>
        <GradientStop Color="#232D3A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Border" Color="#3A4A60"/>
    <LinearGradientBrush x:Key="Button.HoverFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#35475F" Offset="0"/>
        <GradientStop Color="#2E3F56" Offset="0.48"/>
        <GradientStop Color="#26364B" Offset="0.52"/>
        <GradientStop Color="#2B3C53" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.HoverBorder" Color="#5A82B8"/>
    <LinearGradientBrush x:Key="Button.PressedFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A2330" Offset="0"/>
        <GradientStop Color="#222D3B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Face" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5E9BE8" Offset="0"/>
        <GradientStop Color="#3E7FE0" Offset="0.48"/>
        <GradientStop Color="#2A63C5" Offset="0.52"/>
        <GradientStop Color="#3270D3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Accent.HoverFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70A8EE" Offset="0"/>
        <GradientStop Color="#4C8AE6" Offset="0.48"/>
        <GradientStop Color="#3270D3" Offset="0.52"/>
        <GradientStop Color="#3A7BE6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Accent.Border" Color="#1C4A99"/>

    <LinearGradientBrush x:Key="Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B3B52" Offset="0"/>
        <GradientStop Color="#243247" Offset="0.5"/>
        <GradientStop Color="#1E2A3C" Offset="0.5"/>
        <GradientStop Color="#223046" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Header.Band" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Accent.Rule" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#003A7BE6" Offset="0"/>
        <GradientStop Color="#3A7BE6" Offset="0.2"/>
        <GradientStop Color="#6FA2EE" Offset="0.6"/>
        <GradientStop Color="#003A7BE6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Row.Selected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#294062" Offset="0"/>
        <GradientStop Color="#203351" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Row.SelectedBorder" Color="#3E5F8E"/>
    <SolidColorBrush x:Key="Row.Hover" Color="#222C39"/>
    <SolidColorBrush x:Key="Row.HoverBorder" Color="#334459"/>

    <SolidColorBrush x:Key="Gloss.Edge" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Danger.Text" Color="#F2827A"/>
    <SolidColorBrush x:Key="Progress.Track" Color="#283445"/>
    <Color x:Key="Shadow.Color">#000814</Color>
    <BitmapImage x:Key="Logo" UriSource="pack://application:,,,/Assets/PeerDM7-dark.png"/>
</ResourceDictionary>

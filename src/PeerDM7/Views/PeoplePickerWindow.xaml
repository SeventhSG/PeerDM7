<v:ChromeWindow x:Class="PeerDM7.Views.PeoplePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PeerDM7.Views"
        xmlns:c="clr-namespace:PeerDM7.Controls"
        Title="Choose people" Width="340" Height="480" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="Cancel_Click" ToolTip="Close"/>
            <TextBlock x:Name="Heading" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
        </DockPanel>

        <Border Grid.Row="1" Margin="8,0,8,0" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <DockPanel>
                <StackPanel x:Name="NamePanel" DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Group name" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" c:Hint.Text="For example, Lab 3 study group" MaxLength="60"/>
                </StackPanel>
                <TextBlock x:Name="Hint" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="People">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox AutomationProperties.Name="{Binding Contact.Title}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Margin="2,5" Checked="Toggled" Unchecked="Toggled">
                                        <StackPanel Orientation="Horizontal">
                                            <c:AvatarView Width="28" Height="28" Radius="4" RingThickness="1.5" Initials="{Binding Contact.Initials}" Ring="{Binding Contact.Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,10,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Contact.Title}"/>
                                                <TextBlock Text="{Binding Contact.StatusLabel}" FontSize="11.5" Foreground="{DynamicResource Text.Tertiary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="Empty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"
                               Text="Nobody else is online yet. People show up once they open PeerDM7 on the same network."/>
                </Grid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,10,12,12">
            <Button Style="{StaticResource Button.Standard}" Content="Cancel" Click="Cancel_Click" MinWidth="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="Ok" AutomationProperties.Name="Confirm" Style="{StaticResource Button.Accent}" MinWidth="88" Click="Ok_Click" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</v:ChromeWindow>

<v:ChromeWindow x:Class="PeerDM7.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PeerDM7.Views"
        xmlns:c="clr-namespace:PeerDM7.Controls"
        Title="PeerDM7" Width="340" Height="460" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimize"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/PeerDM7.png" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="PeerDM7" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="10,0,10,0" Style="{StaticResource Panel}">
            <Grid>
                <Rectangle Fill="{DynamicResource Bg.Glow}" IsHitTestVisible="False"/>
                <StackPanel Margin="28,36,28,24">
                    <c:AvatarView x:Name="Preview" Width="96" Height="96" Radius="7" Ring="{x:Static c:StatusToBrush.Online}" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="24" Margin="0,18,0,4" HorizontalAlignment="Center"><Run Text="peer" FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource Accent.Text}"/><Run Text="DM7" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Text="Pick a name people on your network will see." Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock Text="Username" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" c:Hint.Text="For example, Dave" MaxLength="40" TextChanged="NameBox_TextChanged" KeyDown="NameBox_KeyDown"/>
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Danger.Text}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <Button x:Name="Go" Style="{StaticResource Button.Accent}" Content="Sign in" Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="Go_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="18,10,18,12" FontSize="11.5" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" TextAlignment="Center"
                   Text="No account and no server. Your name and chats exist only while PeerDM7 is open."/>
    </Grid>
</v:ChromeWindow>
